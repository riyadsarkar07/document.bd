# ─────────────────────────────────────────────────────────────────────────────
# Publish Pipeline (server-side only)
# The /api/publish route uses these variables to commit TM records + certificate
# JPGs into the separate `dpdt-govbd-main` verification portal repository.
#
# NEVER reference these from client components, and never commit the real
# GITHUB_TOKEN. Copy this file to `.env.local` (gitignored) and fill in values.
# ─────────────────────────────────────────────────────────────────────────────

# Fine-grained GitHub Personal Access Token scoped to ONLY:
#   Repository: riyadsarkar07/dpdt-govbd-main → Contents: Read and write
GITHUB_TOKEN=

# Target repository identity
GITHUB_OWNER=riyadsarkar07
GITHUB_REPO=dpdt-govbd-main
GITHUB_BRANCH=main

# Deployed verification portal root (used to confirm the record is live).
# This is the canonical value — the domain is now served by the
# `dpdt-govbd-main` Vercel project. Server code falls back to this same value
# when the variable is unset.
PUBLIC_VERIFY_BASE_URL=https://dpdt-govbd-trademek-database.vercel.app

# Optional client-side override for the History → View Live link
# (inlined at build time by Next.js). Leave unset to use the canonical default
# above; set it ONLY if the portal domain ever changes.
# NEXT_PUBLIC_VERIFY_BASE_URL=https://dpdt-govbd-trademek-database.vercel.app
